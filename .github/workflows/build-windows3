name: Build Windows CUDA (Pro-Fixer Version)
on: [workflow_dispatch]

jobs:
  build:
    runs-on: windows-2022
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          repository: 'turbo-tan/llama.cpp-tq3'
          ref: 'fix/mtp-shared-model'
          submodules: 'recursive'
          fetch-depth: 0

      - name: Install CUDA Toolkit 12.5.1
        id: cuda-toolkit
        uses: Jimver/cuda-toolkit@master
        with:
          cuda: '12.5.1' 

      - name: Configure CMake (精简核心，关闭所有无用测试)
        shell: pwsh
        run: |
          $env:CUDA_PATH = "${{ steps.cuda-toolkit.outputs.CUDA_PATH }}"
          $env:PATH = "$env:CUDA_PATH\bin;$env:PATH"
          
          # 核心魔法：加入了 -DLLAMA_BUILD_TESTS=OFF 和 -DLLAMA_BUILD_EXAMPLES=OFF
          # 这样 MSVC 就不会去编译那些会报错的周边工具，只会编译完美的 llama-server！
          cmake -B build -G "Visual Studio 17 2022" -A x64 `
            -DGGML_CUDA=ON `
            -DGGML_CUDA_FA=ON `
            -DCMAKE_CUDA_ARCHITECTURES=89 `
            -DCMAKE_BUILD_TYPE=Release `
            -DLLAMA_CURL=OFF `
            -DLLAMA_BUILD_TESTS=OFF `
            -DLLAMA_BUILD_EXAMPLES=ON

      - name: Build Project (只编译核心 server)
        shell: pwsh
        run: |
          # 移除了 continue-on-error，这次必须以 exit code 0 完美通关！
          cmake --build build --config Release --target llama-server -j 4

      - name: Bundle DLLs
        shell: pwsh
        run: |
          $cuda_bin = "${{ steps.cuda-toolkit.outputs.CUDA_PATH }}\bin"
          $dest = "build\bin\Release"
          Copy-Item "$cuda_bin\cudart64_12.dll" -Destination "$dest\"
          Copy-Item "$cuda_bin\cublas64_12.dll" -Destination "$dest\"
          Copy-Item "$cuda_bin\cublasLt64_12.dll" -Destination "$dest\"
          Copy-Item "$cuda_bin\cusparse64_12.dll" -Destination "$dest\"

      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: llama-cpp-tq3-4070TiS-FIXED
          path: build/bin/Release/
